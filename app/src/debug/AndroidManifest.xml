<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:name=".MathApplication">
        <activity
            android:name=".MinecraftGameHostLabActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".GameHostActivity"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:launchMode="singleTask"
            android:process=":game_host"
            android:resizeableActivity="false"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.MathClient.GameHost">
            <meta-data
                android:name="android.app.lib_name"
                android:value="minecraftpe" />
        </activity>

        <activity-alias
            android:name="com.mojang.minecraftpe.MainActivity"
            android:exported="false"
            android:targetActivity=".GameHostActivity">
            <meta-data
                android:name="android.app.lib_name"
                android:value="minecraftpe" />
        </activity-alias>
    </application>
</manifest>
