<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="false" />

    <queries>
        <package android:name="com.mojang.minecraftpe" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_math_logo"
        android:roundIcon="@drawable/ic_math_logo"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MathClient">

        <activity
            android:name=".BootstrapActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DiagnosticsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".HostCompatibilityActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".EglLabActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".RenderStateLabActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".FastGuardLabActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

    </application>

</manifest>
